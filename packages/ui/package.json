{
  "name": "@lyricon/ui",
  "version": "0.0.0",
  "description": "Lyricon design system UI components",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./atoms": {
      "types": "./dist/atoms.d.ts",
      "import": "./dist/atoms.js",
      "default": "./dist/atoms.js"
    },
    "./molecules": {
      "types": "./dist/molecules.d.ts",
      "import": "./dist/molecules.js",
      "default": "./dist/molecules.js"
    },
    "./organisms": {
      "types": "./dist/organisms.d.ts",
      "import": "./dist/organisms.js",
      "default": "./dist/organisms.js"
    }
  },
  "files": [
    "dist"
  ],
  "style": "dist/index.css",
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "echo dev",
    "build": "tsup",
    "lint": "echo lint"
  },
  "dependencies": {
    "@lyricon/styles": "workspace:*"
  },
  "devDependencies": {
    "react": "^19.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsup": "^8.3.5"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  }
}
